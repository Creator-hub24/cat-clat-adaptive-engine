# Copy to .streamlit/secrets.toml for local runs (never commit it),
# or paste into Streamlit Cloud > your app > Settings > Secrets.
# Every block is optional: missing blocks => that feature falls back gracefully.

# --- AI generation ---
GEMINI_API_KEY = "your-gemini-api-key"
# GEMINI_MODEL = "gemini-2.5-flash"      # optional override

# --- Privacy: secret used to hash emails into user IDs. Long random string; NEVER change it after launch
# (changing it orphans everyone's saved progress). Generate: python -c "import secrets;print(secrets.token_hex(32))"
PEPPER = "replace-with-64-random-hex-chars"

# --- Storage (Supabase). Service-role key: server-side only, never expose in client code.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_KEY = "your-supabase-service-role-key"

# --- Payments (Razorpay). Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID = "rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET = "your-razorpay-key-secret"
# Optional static fallback link (cannot be auto-verified; the app normally creates a per-user link via API)
RAZORPAY_PAYMENT_LINK = "https://rzp.io/l/your-link"
APP_URL = "https://cat-clat-adaptive-engine-gzkqrxpowaogew7ptmabip.streamlit.app/"

# --- Google login (Streamlit native auth) ---
[auth]
redirect_uri = "https://cat-clat-adaptive-engine-gzkqrxpowaogew7ptmabip.streamlit.app/oauth2callback"
cookie_secret = "another-long-random-string"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
